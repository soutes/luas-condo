+def test_imap_readonly_mailbox_access_examine_mode():
+    """Verify IMAP client enforces strictly read-only EXAMINE mode and no modification commands."""
+    mock_client = MagicMock()
+    mock_client.select.return_value = ("OK", [b"0"])
