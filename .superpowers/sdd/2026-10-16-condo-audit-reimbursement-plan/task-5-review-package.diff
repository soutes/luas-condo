+def test_parse_multipart_email_with_pdf_attachment():
+    """Verify parsing RFC822 multipart email extracts headers, body, and PDF attachment."""
+    msg = MIMEMultipart()
+    msg["From"] = "condominio@syndkos.com.br"
+    msg["To"] = "luizaugustosoutes@gmail.com"
