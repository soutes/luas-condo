+            "telefone": "55 48 99999-9999",
+            "contrato": "09638.003.03",
+            "observacoes": "Replay dead-letter submission",
+        },
+        status=StatusSubmissao.ERRO,
+        protocolo_retorno=None,
+        tentativas=1,
+        trace_id=trace_id,
+        enviado_em=datetime.now(timezone.utc),
+    )
+    db_session.add(submissao)
+    db_session.commit()
+
+    alert_payload = {
