+
+def test_audit_zero_reimbursement():
+    """Verify report when there are only ordinary expenses."""
+    bill = ParsedCondoBill(
+        condominio_nome="CONDOMINIO EDIFICIO VILLA SALOMY",
+        competencia="2026-09",
+        data_vencimento=date(2026, 10, 10),
