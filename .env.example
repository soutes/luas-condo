# Luas Condo Environment Configuration
# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=luas_condo
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/luas_condo

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-secret-key-32chars

# Bitrix24 submission settings
MOCK_SUBMISSION=false
IBAGY_TENANT_EMAIL=soutes@gmail.com
IBAGY_TENANT_PHONE=48999999999
MOCK_BITRIX_URL=http://mock-bitrix:8080
# Real submissions drive the Ibagy form (a Bitrix24 JavaScript widget) with Chromium, which is
# NOT installed by default so small hosts stay light. To enable it: set INSTALL_BROWSER=true and
# rebuild (docker compose build backend). The browser refuses to start when free RAM is below
# BROWSER_MIN_FREE_MB. Telefone format is normalised to "55 XX 9XXXX-XXXX".
INSTALL_BROWSER=false
BROWSER_MIN_FREE_MB=300
IBAGY_TENANT_NAME=seu_nome_completo
IBAGY_TENANT_EMAIL=seu_email_aqui
IBAGY_TENANT_PHONE=seu_telefone_com_ddd
IBAGY_CONTRACT_NUM=seu_numero_de_contrato_aqui
IBAGY_BITRIX_URL=https://ibagy.bitrix24.site/condominioressarcimento/ressarcimento/
# Preencha com o seu numero de contrato com a Ibagy (conforme contrato de locacao e e-mails mensais):
CONTRATO_PADRAO=seu_numero_de_contrato_aqui

# Document parsing settings
# Preencha com a sua senha de abertura do boleto PDF indicada no e-mail mensal da Ibagy/administradora (ex: primeiros digitos do seu CPF):
CONDO_PDF_PASSWORD=sua_senha_do_boleto_aqui

# IMAP Email poller settings
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASSWORD=app-specific-password
IMAP_READ_ONLY=true
SYNDKOS_EMAIL_SENDER=naoresponda@syndkos.com.br

# Telemetry and monitoring
OTEL_SERVICE_NAME=luas_condo_backend
# OTLP/HTTP endpoint (Jaeger all-in-one). Leave empty to disable trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
PROMETHEUS_METRICS_PORT=8000
# Shared bearer token Alertmanager uses to call /api/alerts/webhook. Without it the
# webhook refuses every request (fail closed). Generate one: openssl rand -hex 32
ALERT_WEBHOOK_TOKEN=
# Key required by the write API (send, sync, upload, delete). Without it every write
# request is refused (fail closed). Enter the same value in the app under "Chave de acesso".
# Generate one: openssl rand -hex 32
API_WRITE_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host port binding overrides (see docs/vm-port-allocation-runbook.md).
# Defaults bind every published port to loopback so the stacks sharing the
# Oracle VM never conflict and nothing is exposed directly. Public traffic
# goes through the shared Caddy via the external `web` network.
# Do NOT commit real secrets in this file.

# Host bind address (use 0.0.0.0 only if you fully understand the exposure).
POSTGRES_HOST_IP=127.0.0.1
BACKEND_HOST_IP=127.0.0.1
MOCK_BITRIX_HOST_IP=127.0.0.1
FRONTEND_HOST_IP=127.0.0.1
PROMETHEUS_HOST_IP=127.0.0.1
GRAFANA_HOST_IP=127.0.0.1
ALERTMANAGER_HOST_IP=127.0.0.1
JAEGER_HOST_IP=127.0.0.1

# Host ports (must stay unique across ALL stacks on the shared VM).
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
MOCK_BITRIX_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
ALERTMANAGER_HOST_PORT=9093
JAEGER_HOST_PORT=16686
