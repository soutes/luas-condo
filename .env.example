# Luas Condo Environment Configuration
# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=luas_condo
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/luas_condo

# Application settings
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-secret-key-32chars

# Bitrix24 submission settings
MOCK_SUBMISSION=true
MOCK_BITRIX_URL=http://mock-bitrix:8080
IBAGY_BITRIX_URL=https://ibagy.bitrix24.site/condominioressarcimento/ressarcimento/
CONTRATO_PADRAO=09638.003.03

# Document parsing settings
CONDO_PDF_PASSWORD=04293

# IMAP Email poller settings
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASSWORD=app-specific-password
IMAP_READ_ONLY=true
SYNDKOS_EMAIL_SENDER=naoresponda@syndkos.com.br

# Telemetry and monitoring
OTEL_SERVICE_NAME=luas_condo_backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PORT=8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host port binding overrides (see docs/vm-port-allocation-runbook.md).
# Defaults bind every published port to loopback so the stacks sharing the
# Oracle VM never conflict and nothing is exposed directly. Public traffic
# goes through the shared Caddy via the external `web` network.
# Do NOT commit real secrets in this file.

# Host bind address (use 0.0.0.0 only if you fully understand the exposure).
POSTGRES_HOST_IP=127.0.0.1
BACKEND_HOST_IP=127.0.0.1
MOCK_BITRIX_HOST_IP=127.0.0.1
FRONTEND_HOST_IP=127.0.0.1
PROMETHEUS_HOST_IP=127.0.0.1
GRAFANA_HOST_IP=127.0.0.1

# Host ports (must stay unique across ALL stacks on the shared VM).
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
MOCK_BITRIX_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
