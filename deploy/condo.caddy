# Regra do Caddy para o Luas Condo (importada pelo Caddyfile do ApitaCerto, que monta
# /opt/caddy-sites em /etc/caddy/sites). HTTPS automatico (Let's Encrypt) via sslip.io:
# o nome resolve para o IP da VM, sem cadastro.
condo.147-15-76-139.sslip.io {
	encode gzip

	handle /api* {
		reverse_proxy luas_condo_backend:8000 {
			lb_try_duration 5s
			transport http {
				dial_timeout 2s
			}
		}
	}

	handle /docs* {
		reverse_proxy luas_condo_backend:8000
	}

	handle /openapi.json {
		reverse_proxy luas_condo_backend:8000
	}

	handle {
		reverse_proxy luas_condo_frontend:5173 {
			lb_try_duration 5s
			transport http {
				dial_timeout 2s
			}
		}
	}
}
